<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部用户信息 -->
  <view class="header card">
    <view class="user-info">
      <view class="avatar">{{nameInitial}}</view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-role">{{roleText}}</text>
      </view>
    </view>
    <view class="subscribe-btn" bindtap="reSubscribe">
      <text>🔔 通知设置</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{todayCount}}</text>
      <text class="stat-label">今日任务</text>
    </view>
    <view class="stat-card stat-card-blue">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">累计任务</text>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="section-title">
    <text>最近行程</text>
    <view wx:if="{{tasks.length > 0}}" class="clear-btn" bindtap="clearAllTasks">
      <text>清除记录</text>
    </view>
  </view>

  <view wx:if="{{tasks.length === 0}}" class="empty-tip card">
    <text>暂无行程任务</text>
    <text class="empty-sub">收到通知后将在这里显示</text>
  </view>

  <view wx:for="{{tasks}}" wx:key="id" class="task-card card">
    <view class="task-header">
      <view class="task-date">{{item.date}} {{item.departureTime}}</view>
      <view class="task-status tag-{{item.status}}">
        {{item.statusText}}
      </view>
    </view>
    <view class="task-body">
      <!-- 司机信息 -->
      <view class="task-row" wx:if="{{item.driverName || item.driverPhone}}">
        <text class="task-icon">👨‍✈️</text>
        <text class="task-text">司机：{{item.driverName || '未登记'}} {{item.driverPhone}}</text>
      </view>
      <!-- 业务员信息 -->
      <view class="task-row" wx:if="{{item.salespersonName || item.salespersonPhone}}">
        <text class="task-icon">💼</text>
        <text class="task-text">业务员：{{item.salespersonName || '未登记'}} {{item.salespersonPhone}}</text>
      </view>
      <!-- 航班/高铁信息 -->
      <view class="task-row" wx:if="{{item.flightInfo}}">
        <text class="task-icon">✈️</text>
        <text class="task-text">航班/高铁：{{item.flightInfo}}</text>
      </view>
      <!-- 车辆信息 -->
      <view class="task-row" wx:if="{{item.vehiclePlate}}">
        <text class="task-icon">🚗</text>
        <text class="task-text">车牌：{{item.vehiclePlate}}</text>
      </view>
    </view>
  </view>
</view>
