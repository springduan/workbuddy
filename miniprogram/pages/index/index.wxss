/* pages/index/index.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background: #1a56db;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
}

.user-role {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-top: 4rpx;
}

.subscribe-btn {
  background: #eff4ff;
  color: #1a56db;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-card-blue {
  background: #1a56db;
}

.stat-num {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.stat-card-blue .stat-num,
.stat-card-blue .stat-label {
  color: #fff;
}

.stat-label {
  font-size: 26rpx;
  color: #888;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clear-btn {
  font-size: 26rpx;
  color: #c62828;
  font-weight: normal;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #aaa;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
}

.task-card {
  margin-bottom: 20rpx;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.task-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.task-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-icon {
  font-size: 28rpx;
  width: 40rpx;
}

.task-text {
  font-size: 28rpx;
  color: #555;
  flex: 1;
}

.tag-normal {
  background: #e8f5e9;
  color: #2e7d32;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.tag-delay {
  background: #fff3e0;
  color: #e65100;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.tag-cancel {
  background: #ffebee;
  color: #c62828;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}
