/* pages/agreement/agreement.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #f5f7fa;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  line-height: 1.5;
}

.content {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx 40rpx;
}

.section {
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}

.text view {
  margin: 6rpx 0;
}
