/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 60rpx 40rpx 40rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: #1a56db;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

.form-card {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  background: #fafafa;
}

.role-picker {
  display: flex;
  gap: 20rpx;
}

.role-btn {
  flex: 1;
  height: 88rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #666;
  background: #fafafa;
  transition: all 0.2s;
}

.role-btn-active {
  border-color: #1a56db;
  background: #eff4ff;
  color: #1a56db;
  font-weight: bold;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background: #1a56db;
  color: #fff;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  margin-bottom: 24rpx;
}

.tip {
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
}
