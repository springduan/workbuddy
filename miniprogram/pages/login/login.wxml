<!-- pages/login/login.wxml -->
<view class="container">
  <view class="logo-area">
    <image wx:if="{{!logoError}}" class="logo" src="/images/logo.png" mode="aspectFit" binderror="onLogoError" />
    <view wx:else class="logo logo-placeholder">🚌</view>
    <text class="title">调度通知系统</text>
    <text class="subtitle">商务车调度平台</text>
  </view>

  <view class="card form-card">
    <view class="form-item">
      <text class="label">您的姓名</text>
      <input
        class="input"
        placeholder="请输入姓名"
        bindinput="onNameInput"
        value="{{name}}"
      />
    </view>

    <view class="form-item">
      <text class="label">您的手机号</text>
      <input
        class="input"
        placeholder="请输入手机号"
        bindinput="onPhoneInput"
        value="{{phone}}"
        type="number"
        maxlength="11"
      />
    </view>

    <view class="form-item">
      <text class="label">身份</text>
      <view class="role-picker">
        <view
          class="role-btn {{role === 'salesperson' ? 'role-btn-active' : ''}}"
          bindtap="selectRole"
          data-role="salesperson"
        >业务员</view>
        <view
          class="role-btn {{role === 'driver' ? 'role-btn-active' : ''}}"
          bindtap="selectRole"
          data-role="driver"
        >司机</view>
      </view>
    </view>
  </view>

  <!-- 隐私协议勾选 -->
  <view class="agreement-area" bindtap="toggleAgreement">
    <view class="checkbox-wrap {{agreed ? 'checked' : ''}}">
      <view class="checkbox-icon {{agreed ? 'icon-checked' : 'icon-unchecked'}}">
        <text wx:if="{{agreed}}" class="check-mark">✓</text>
      </view>
    </view>
    <view class="agreement-text">
      <text>我已阅读并同意</text>
      <text class="link" catchtap="goPrivacy">《隐私政策》</text>
      <text>和</text>
      <text class="link" catchtap="goAgreement">《用户服务协议》</text>
    </view>
  </view>

  <button class="btn-primary {{!agreed ? 'btn-disabled' : ''}}" bindtap="onLogin" loading="{{loading}}" disabled="{{!agreed}}">
    登录
  </button>

  <text class="tip">登录后可接收行程派车通知</text>

  <!-- 授权弹窗 -->
  <view class="subscribe-modal" wx:if="{{pendingUser}}">
    <view class="modal-mask"></view>
    <view class="modal-content">
      <view class="modal-title">开启消息通知</view>
      <view class="modal-desc">订阅通知后，您可以及时收到派车任务推送</view>
      <view class="modal-info">手机号：{{pendingUser.phone}}</view>
      <view class="modal-info">身份：{{pendingUser.role === 'driver' ? '司机' : '业务员'}}</view>
      <button class="btn-subscribe" bindtap="onAuthorizeSubscribe">
        授权通知
      </button>
      <view class="btn-skip" bindtap="onSkipSubscribe">暂不授权</view>
    </view>
  </view>
</view>
